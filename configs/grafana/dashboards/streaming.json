{
  "dashboard": {
    "title": "WebRTC HLS Pipeline",
    "panels": [
      {
        "title": "Active Streams",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
        "targets": [{ "expr": "streams_active" }]
      },
      {
        "title": "WebSocket Connections",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
        "targets": [{ "expr": "websocket_connections" }]
      },
      {
        "title": "Chat Messages (rate)",
        "type": "graph",
        "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
        "targets": [{ "expr": "rate(chat_messages_total[1m])" }]
      },
      {
        "title": "FFmpeg Restarts",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
        "targets": [{ "expr": "ffmpeg_restarts_total" }]
      },
      {
        "title": "Segment Lag",
        "type": "graph",
        "gridPos": { "h": 6, "w": 12, "x": 0, "y": 4 },
        "targets": [{ "expr": "histogram_quantile(0.95, rate(segment_lag_seconds_bucket[5m]))" }]
      },
      {
        "title": "Viewers per Session",
        "type": "graph",
        "gridPos": { "h": 6, "w": 12, "x": 12, "y": 4 },
        "targets": [{ "expr": "viewers_active" }]
      }
    ]
  }
}
